{
  "t": "Rail travel time (minutes)",
  "raw": false,
  "trimFactor": 0,
  "quantileSource": "map",
  "defaultValue": null,
  "infill": false,
  "flip": false,
  "cartogram": "cartogram_weights_europe_hilo",
  "controls": {
    "travelTime": {
      "label": "Travel time",
      "type": "number",
      "unit": "min",
      "default": 10080,
      "min": 0,
      "max": 10080,
      "step": 15,
      "encode": "value => Math.round(value * 60)"
    },
    "departure": {
      "label": "Departure",
      "type": "time",
      "default": "00:00",
      "encode": "value => value.length === 5 ? value + ':00' : value"
    }
  },
  "onclick": {
    "url": "http://127.0.0.1:1988/reachable?index={index}&departure={controls.departure}&budget_s={controls.travelTime}&window_s=86400&step_s=900&encoding=split&metric=distance_time_quantile",
    "resolution": 5,
    "defaultAction": false
  }
}
