{
  "t": "Average public transport travel time from {TOWN_NAME} (hours), first departure {controls.departure}",
  "raw": false,
  "trimFactor": 0,
  "quantileSource": "map",
  "defaultValue": null,
  "infill": false,
  "flip": false,
  "cartogram": "cartogram_weights_europe_hilo",
  "controls": {
    "travelTime": {
      "label": "Travel time",
      "type": "number",
      "unit": "h",
      "default": 168,
      "min": 0,
      "max": 168,
      "step": 0.25
    },
    "departure": {
      "label": "Departure",
      "type": "time",
      "unit": "h",
      "default": "08:00",
      "encode": "t => t.split(':').reduce((h, m) => +h + m / 60)"
    }
  },
  "onclick": {
    "_old_url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travelTime}&encoding=split&max_walk_h=1",
    "_url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travelTime}&window_h=24&step_h=0.25&encoding=split&metric=distance_time_quantile&max_walk_h=1&distance_mode=straight_line",
    "_no_walk_url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travelTime}&window_h=24&step_h=0.25&encoding=split&metric=distance_time_quantile&max_walk_h=0",
    "url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&window_h=11&step_h=0.25&budget_h=6&encoding=split&max_walk_h=1&distance_mode=straight_line&window_mode=min_union",
    "resolution": 7,
    "focus": false,
    "highlight": true
  },
  "onmove": {
    "socket": "wss://proto.olie.science/router/query",
    "url": "/reachable?index={index}&departure_h={controls.departure}&window_h=11&step_h=0.25&budget_h=3&encoding=split&max_walk_h=1&distance_mode=straight_line",
    "resolution": 8,
    "wait": 0,
    "_comment": "documented in docs/query-websocket.md"
  }
}
