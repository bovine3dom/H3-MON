{
  "t": "Rail travel time from {TOWN_NAME} (minutes)",
  "raw": false,
  "trimFactor": 0,
  "quantileSource": "map",
  "defaultValue": null,
  "infill": false,
  "flip": false,
  "cartogram": "cartogram_weights_europe_hilo",
  "controls": {
    "travelTime": {
      "label": "Travel time",
      "type": "number",
      "unit": "min",
      "default": 10080,
      "min": 0,
      "max": 10080,
      "step": 15,
      "encode": "value => Math.round(value * 60)"
    },
    "departure": {
      "label": "Departure",
      "type": "time",
      "default": "00:00",
      "encode": "value => value.length === 5 ? value + ':00' : value"
    }
  },
  "onclick": {
    "_old_url": "http://127.0.0.1:1988/reachable?index={index}&departure={controls.departure}&budget_s={controls.travelTime}&encoding=split&max_walk_s=3600",
    "url": "http://127.0.0.1:1988/reachable?index={index}&departure={controls.departure}&budget_s={controls.travelTime}&window_s=86400&step_s=900&encoding=split&metric=distance_time_quantile&max_walk_s=3600",
    "_no_walk_url": "http://127.0.0.1:1988/reachable?index={index}&departure={controls.departure}&budget_s={controls.travelTime}&window_s=86400&step_s=900&encoding=split&metric=distance_time_quantile&max_walk_s=0",
    "resolution": 7,
    "focus": false,
    "highlight": true
  },
  "onmove": {
    "socket": "ws://127.0.0.1:1988/query",
    "url": "/reachable?index={index}&departure={controls.departure}&window_s=86400&step_s=900&budget_s=10800&encoding=split&max_walk_s=3600&distance_mode=straight_line",
    "resolution": 7,
    "wait": 0,
    "_comment": "documented in docs/query-websocket.md"
  }
}
