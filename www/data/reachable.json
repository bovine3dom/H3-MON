{
  "t": "{controls.window_mode} {controls.metric} by public transport from {TOWN_NAME}, first departure {controls.departure}, departures sampled every {controls.step_size} hours until {controls.window_size} hours later",
  "c": "bovine3dom, Transitous et al.",
  "raw": false,
  "trimFactor": 0,
  "quantileSource": "map",
  "defaultValue": null,
  "infill": false,
  "flip": true,
  "cartogram": "cartogram_weights_europe_hilo",
  "_cartogram": "none",
  "colourScale": "linear",
  "requireCompleteCoverage": true,
  "controls": {
    "departure": {
      "label": "First departure",
      "type": "time",
      "unit": "h",
      "default": "08:00",
      "encode": "t => t.split(':').reduce((h, m) => +h + m / 60)"
    },
    "travel_time": {
      "label": "Travel time",
      "type": "number",
      "unit": "h",
      "default": 168,
      "min": 0,
      "max": 168,
      "step": 0.25
    },
    "walk_time": {
      "label": "Maximum walking time per leg",
      "type": "number",
      "unit": "h",
      "default": 1,
      "min": 0,
      "max": 6,
      "step": 0.25
    },
    "window_size": {
      "label": "Window length in which to sample departures",
      "type": "number",
      "unit": "h",
      "default": 12,
      "min": 0,
      "max": 24,
      "step": 1
    },
    "step_size": {
      "label": "Frequency with which to sample departures",
      "type": "number",
      "unit": "h",
      "default": 0.25,
      "min": 0.05,
      "max": 6,
      "step": 0.25
    },
    "window_mode": {
      "label": "Window mode",
      "type": "select",
      "default": "mean_intersection",
      "options": [
        {"value": "mean_intersection", "label": "Average"},
        {"value": "min_union", "label": "Best-case"},
        {"value": "max_intersection", "label": "Worst-case"},
        {"value": "diff_union", "label": "Difference between best and worst case"},
        {"value": "diff_intersection", "label": "Difference between best and worst case (always reachable)"},
        {"value": "reachable_union", "label": "Fraction of departures for which the destination is reachable within the travel budget"}
      ]
    },
    "metric": {
      "label": "Metric",
      "type": "select",
      "default": "distance_time_quantile",
      "options": [
        {"value": "distance_time_quantile", "label": "distance quantile - time quantile"},
        {"value": "time", "label": "travel time (h)"}
      ]
    }
  },
  "onclick": {
    "_old_url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travel_time}&encoding=split&max_walk_h={controls.walk_time}",
    "_url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travel_time}&window_h={controls.window_size}&step_h={controls.step_size}&encoding=split&metric={controls.metric}&max_walk_h={controls.walk_time}&distance_mode=straight_line",
    "_no_walk_url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travel_time}&window_h={controls.window_size}&step_h={controls.step_size}&encoding=split&metric={controls.metric}&max_walk_h={controls.walk_time}",
    "url": "https://proto.olie.science/router/reachable?index={index}&departure_h={controls.departure}&window_h={controls.window_size}&step_h={controls.step_size}&budget_h={controls.travel_time}&encoding=split&max_walk_h={controls.walk_time}&distance_mode=straight_line&window_mode={controls.window_mode}&metric={controls.metric}",
    "resolution": 6,
    "focus": false,
    "highlight": true
  },
  "_onmove": {
    "socket": "wss://proto.olie.science/router/query",
    "url": "/reachable?index={index}&departure_h={controls.departure}&window_h={controls.window_size}&step_h={controls.step_size}&budget_h=3&encoding=split&max_walk_h={controls.walk_time}&distance_mode=straight_line&window_mode={controls.window_mode}&metric={controls.metric}",
    "resolution": 8,
    "wait": 0,
    "_comment": "documented in docs/query-websocket.md"
  }
}
