{
  "t": "Rail travel time from {TOWN_NAME} (hours)",
  "raw": false,
  "trimFactor": 0,
  "quantileSource": "map",
  "defaultValue": null,
  "infill": false,
  "flip": false,
  "cartogram": "cartogram_weights_europe_hilo",
  "controls": {
    "travelTime": {
      "label": "Travel time",
      "type": "number",
      "unit": "h",
      "default": 168,
      "min": 0,
      "max": 168,
      "step": 0.25
    },
    "departure": {
      "label": "Departure",
      "type": "number",
      "unit": "h",
      "default": 0,
      "min": 0,
      "max": 23.9999997,
      "step": 0.25
    }
  },
  "onclick": {
    "_old_url": "http://127.0.0.1:1988/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travelTime}&encoding=split&max_walk_h=1",
    "url": "http://127.0.0.1:1988/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travelTime}&window_h=24&step_h=0.25&encoding=split&metric=distance_time_quantile&max_walk_h=1&distance_mode=straight_line",
    "_no_walk_url": "http://127.0.0.1:1988/reachable?index={index}&departure_h={controls.departure}&budget_h={controls.travelTime}&window_h=24&step_h=0.25&encoding=split&metric=distance_time_quantile&max_walk_h=0",
    "resolution": 7,
    "focus": false,
    "highlight": true
  },
  "onmove": {
    "socket": "ws://127.0.0.1:1988/query",
    "url": "/reachable?index={index}&departure_h=8&window_h=16&step_h=0.25&budget_h=6&encoding=split&max_walk_h=1&distance_mode=straight_line",
    "resolution": 7,
    "wait": 0,
    "_comment": "documented in docs/query-websocket.md"
  }
}
