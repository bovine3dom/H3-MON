        "@deck.gl/mapbox": "9.0.14",
        "@deck.gl/mesh-layers": "9.0.14",
        "@loaders.gl/arrow": "^4.3.3",
        "@loaders.gl/csv": "^4.2.1",
        "@loaders.gl/parquet": "^4.3.4",
        "d3": "^7.9.0",
        "deno-bin": "^1.43.5",
        "esbuild": "^0.21.3",
        "faster-h3-for-deckgl": "https://github.com/bovine3dom/faster-h3-for-deckgl",
